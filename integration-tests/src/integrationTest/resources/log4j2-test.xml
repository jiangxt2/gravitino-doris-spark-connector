<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only Log4j2 configuration: route slf4j output (testcontainers,
     docker compose, DorisTestCluster) to the console so infrastructure
     startup failures are visible in CI logs. InMemoryLogCapture installs
     its own appender on top of this configuration. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="CONSOLE"/>
    </Root>
  </Loggers>
</Configuration>
